# Base de datos (Neon). DATABASE_URL: conexión con pooler (la usa la app). DIRECT_URL: conexión directa (la usan las migraciones).
DATABASE_URL=
DIRECT_URL=

# Auth.js. AUTH_SECRET: genera uno con `openssl rand -base64 32`. AUTH_URL: URL pública de la app.
AUTH_SECRET=
AUTH_URL=

# Cloudinary (almacenamiento de imágenes).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenRouter (análisis de prendas, estilista, compras). OPENROUTER_MODEL es el modelo por defecto; las otras tres lo sustituyen por tarea.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODEL_VISION=
OPENROUTER_MODEL_STYLIST=
OPENROUTER_MODEL_CHEAP=

# Pollinations.ai (probador virtual). La clave sk_ es solo de servidor. MAX_REFERENCES: nº máximo de imágenes enviadas (persona + prendas).
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=
POLLINATIONS_BASE_URL=
POLLINATIONS_MAX_REFERENCES=
POLLINATIONS_IMAGE_SIZE=

# Catálogo de tiendas (opcional). Awin: ID de publisher y clave de datos de feeds. CATALOG_STORES: tiendas permitidas, separadas por comas. CATALOG_FEEDS_JSON: otros feeds CSV autorizados. CRON_SECRET (mín. 16 caracteres) protege /api/cron/catalog-sync.
AWIN_PUBLISHER_ID=
AWIN_DATAFEED_KEY=
CATALOG_STORES=
CATALOG_REGION=
CATALOG_MAX_ROWS_PER_FEED=
CATALOG_FEEDS_JSON=
CRON_SECRET=

# Correo (verificación de email y recuperación de contraseña). Sin SMTP_HOST, los enlaces se imprimen en la consola del servidor (solo desarrollo).
#SMTP_HOST=
#SMTP_PORT=
#SMTP_USER=
#SMTP_PASSWORD=
#EMAIL_FROM=

# Zona horaria de la app y límites de uso por usuario y día.
APP_TIMEZONE=
AI_DAILY_LIMIT_PER_USER=
TRYON_DAILY_LIMIT_PER_USER=

# URL pública de la app (se usa en los enlaces de los correos).
NEXT_PUBLIC_APP_URL=
