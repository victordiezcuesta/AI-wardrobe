# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.
# Una variable vacía (CLAVE=) equivale a no definida: se aplica su valor por defecto, si lo tiene.
# [obligatoria] = la app no arranca sin ella · [por defecto: …] = valor usado si se deja vacía.

# Base de datos (Neon). DATABASE_URL [obligatoria]: conexión con pooler (la usa la app). DIRECT_URL: conexión directa (la usan las migraciones).
# Desarrollo: usa una rama `development` de Neon (Branches → Create branch) y copia aquí SUS dos URLs (pooled y direct).
# Reserva la rama `main` para producción: no la uses en local ni ejecutes migraciones de desarrollo contra ella.
DATABASE_URL=
DIRECT_URL=

# Auth.js. AUTH_SECRET [obligatoria, mín. 16 caracteres]: genera uno con `openssl rand -base64 32`. AUTH_URL: URL pública de la app
# (en local: http://localhost:3000). AUTH_TRUST_HOST: la lee Auth.js directamente (no pasa por src/lib/env) y evita el error
# UntrustedHost. Auth.js confía en el host si AUTH_URL tiene valor, en Vercel o fuera de producción (`next dev`), PERO una
# variable presente y vacía (`AUTH_URL=` o `AUTH_TRUST_HOST=`) cuenta como «no confiar» y anula esa regla incluso en `next dev`.
# En local: rellena AUTH_URL=http://localhost:3000, o bien AUTH_TRUST_HOST=true (también para `next start` o tras un proxy).
# En Vercel no hace falta. Déjala comentada si no la usas:
AUTH_SECRET=
AUTH_URL=
# AUTH_TRUST_HOST=true

# Cloudinary (almacenamiento de imágenes) [las tres obligatorias].
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenRouter (análisis de prendas, estilista, compras). Sin OPENROUTER_API_KEY las funciones de IA responden «no configurado».
# OPENROUTER_MODEL es el modelo común [por defecto: google/gemini-2.5-flash, DE PAGO]; VISION y STYLIST lo sustituyen por tarea.
# OPENROUTER_MODEL_CHEAP [por defecto: OPENROUTER_MODEL o google/gemini-2.5-flash-lite, DE PAGO].
# Plan gratuito (modelos `:free`, comprobados en el catálogo el 20-11-2026; revisa https://openrouter.ai/models?max_price=0):
#   OPENROUTER_MODEL_VISION=nvidia/nemotron-3.5-super-vl:free     (imagen + JSON estructurado; análisis de prendas)
#   OPENROUTER_MODEL_STYLIST=inclusionai/ling-3.2-flash:free      (texto + JSON estructurado; estilista y huecos)
#   OPENROUTER_MODEL_CHEAP=inclusionai/ling-3.2-flash:free        (texto + JSON estructurado; ordenar productos)
# Sin créditos comprados: ~50 peticiones/día a modelos gratuitos para toda la cuenta. Un 429 no se reintenta (AI_RATE_LIMITED).
# En Settings → Privacy de OpenRouter permite los endpoints gratuitos; si no, los `:free` responden 404. Pueden registrar los prompts.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODEL_VISION=
OPENROUTER_MODEL_STYLIST=
OPENROUTER_MODEL_CHEAP=

# Pollinations.ai (probador virtual). La clave sk_ es solo de servidor (una pk_ responde 401).
# POLLINATIONS_MODEL [por defecto: black-forest-labs/flux.2-klein-4b, gratuito: se paga con el saldo Quest, hasta 10 referencias]
#   Recomendado en el plan gratuito: POLLINATIONS_MODEL=black-forest-labs/flux.2-klein-4b
#   Los modelos `paid_only` de https://gen.pollinations.ai/image/models (p. ej. google/gemini-2.5-flash-image) exigen saldo de pago (402).
# POLLINATIONS_BASE_URL [por defecto: https://gen.pollinations.ai]
# POLLINATIONS_MAX_REFERENCES: nº máximo de imágenes enviadas, persona + prendas, entre 1 y 8 [por defecto: 5]. No superes el
#   `max_reference_images` del modelo (flux.2-klein-4b: 10; microsoft/mai-image-*-flash: 5; google/gemini-2.5-flash-image: 3).
# POLLINATIONS_IMAGE_SIZE: formato ANCHOxALTO [por defecto: el del proveedor]. Recomendado: POLLINATIONS_IMAGE_SIZE=1024x1536
#   (flux.2-klein-4b: mín. 256 px por lado y máx. 2.359.296 píxeles; MAI: mín. 768 px por lado y múltiplos de 16).
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=
POLLINATIONS_BASE_URL=
POLLINATIONS_MAX_REFERENCES=
POLLINATIONS_IMAGE_SIZE=

# Catálogo de tiendas (opcional). Awin: ID de publisher y clave de datos de feeds.
# CATALOG_STORES: tiendas permitidas, separadas por comas [por defecto: lista de tiendas españolas definida en src/lib/env]
# CATALOG_REGION [por defecto: ES] · CATALOG_MAX_ROWS_PER_FEED, mín. 100 [por defecto: 60000]
# CATALOG_FEEDS_JSON: otros feeds CSV autorizados. CRON_SECRET (mín. 16 caracteres) protege /api/cron/catalog-sync.
AWIN_PUBLISHER_ID=
AWIN_DATAFEED_KEY=
CATALOG_STORES=
CATALOG_REGION=
CATALOG_MAX_ROWS_PER_FEED=
CATALOG_FEEDS_JSON=
CRON_SECRET=

# Correo (verificación de email y recuperación de contraseña) mediante SMTP.
# Sin SMTP_HOST no se envía nada: los enlaces se imprimen en la consola del servidor (solo para desarrollo).
# SMTP_PORT [por defecto: 587; con 465 se usa TLS directo] · SMTP_USER/SMTP_PASSWORD: opcionales si el servidor no pide autenticación.
# EMAIL_FROM: remitente, p. ej. "AI Wardrobe <no-reply@tudominio.com>" [por defecto: AI Wardrobe <no-reply@localhost>]
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Zona horaria de la app [por defecto: Europe/Madrid] y límites de uso por usuario y día
# (AI_DAILY_LIMIT_PER_USER [por defecto: 60] · TRYON_DAILY_LIMIT_PER_USER [por defecto: 10]).
APP_TIMEZONE=
AI_DAILY_LIMIT_PER_USER=
TRYON_DAILY_LIMIT_PER_USER=

# URL pública de la app, usada en los enlaces de los correos [por defecto: http://localhost:3000].
NEXT_PUBLIC_APP_URL=
